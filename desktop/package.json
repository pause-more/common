{
  "name": "autone-work-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "description": "오토원워크 데스크톱 앱 래퍼",
  "author": "Auto One Co., Ltd.",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:web": "node build-web.mjs",
    "pack": "npm run build:web && electron-builder --mac --dir",
    "dist": "npm run build:web && electron-builder --mac",
    "pack:win": "npm run build:web && electron-builder --win --x64 --dir",
    "dist:win": "npm run build:web && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.autone.work",
    "productName": "오토원워크",
    "afterPack": "afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/webapp",
        "to": "webapp"
      }
    ],
    "mac": {
      "executableName": "AutoneWork",
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/app.icns",
      "extendInfo": {
        "NSHighResolutionCapable": true,
        "LSMinimumSystemVersion": "12.0"
      }
    },
    "win": {
      "icon": "assets/app.ico",
      "target": [
        "dir"
      ]
    }
  }
}
